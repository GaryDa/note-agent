{
    "name": "garyda/note-agent",
    "description": "Practice project: an agent that classifies loose text notes, with a hand-written agent loop",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "NoteAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoteAgent\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "check": [
            "@test",
            "@stan"
        ]
    }
}
